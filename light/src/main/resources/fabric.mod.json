  "id": "shardclient-light",
  "version": "${version}",
  "name": "ShardClient Light",
  "description": "The ShardClient Light Version: the Practice Server integration only.",
  "icon": "assets/shardclient-light/icon.png",
  "license": "GPL-3.0-only",
  "environment": "client",
